{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ANDROID_HOME", "JAVA_HOME"],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.baishou.base.mjs",
    "eslint.cache-coordinator.mjs",
    "scripts/lint-warning-baseline.json",
    "scripts/run-eslint-with-budget.mjs",
    "scripts/lint-targets.mjs",
    "scripts/eslint-plugin-*.mjs"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^test", "^build"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [".eslintcache"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {},
    "db:push": {}
  }
}
