{
  "name": "@baishou/website",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "node scripts/generate-docs-manifest.mjs && vite",
    "start": "pnpm run dev",
    "build": "node scripts/generate-docs-manifest.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4321",
    "check": "node scripts/generate-docs-manifest.mjs && node scripts/check-max-lines.mjs && tsc --noEmit",
    "check:lines": "node scripts/check-max-lines.mjs",
    "lint": "eslint . && node scripts/check-max-lines.mjs",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "lenis": "^1.3.25",
    "lucide-react": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "hast-util-to-string": "^3.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
